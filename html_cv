            font-size: 1.4rem; 
            font-weight: 700; 
            color: #0f172a; 
            margin-bottom: 2rem; 
            display: flex; 
            align-items: center; 
        }
        .section-title::after { 
            content: ''; 
            flex: 1; 
            height: 2px; 
            background-color: #e2e8f0; 
            margin-left: 1rem; 
        }
        
        .profile-text { 
            font-size: 1.05rem; 
            color: #475569; 
            margin-bottom: 3rem; 
            text-align: justify; 
            line-height: 1.7;
        }
        
        /* Timeline for Experience & Education */
        .timeline { 
            border-left: 2px solid #e2e8f0; 
            padding-left: 2rem; 
            margin-bottom: 3rem; 
        }
        .timeline-item { 
            position: relative; 
            margin-bottom: 2.5rem; 
        }
        .timeline-item:last-child { margin-bottom: 0; }
        .timeline-item::before { 
            content: ''; 
            position: absolute; 
            left: -2rem; 
            top: 0.4rem; 
            transform: translateX(-50%); 
            width: 14px; 
            height: 14px; 
            border-radius: 50%; 
            background-color: #0284c7; 
            border: 3px solid #ffffff; 
            box-shadow: 0 0 0 2px #e2e8f0; 
        }
        
        .item-header { 
