            width: 67%; 
            padding: 4rem; 
        }
        
        /* Header */
        .header-section { margin-bottom: 3.5rem; }
        .name { 
            font-size: 3.2rem; 
            font-weight: 700; 
            color: #0f172a; 
            line-height: 1.1; 
